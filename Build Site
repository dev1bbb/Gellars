TEMPLATE = (Path(__file__).parent / "template.html").read_text(encoding="utf-8")


def esc(t):
    return (str(t).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


def build():
    s = SITE
    years = 2026 - s["founded"]
    story = "\n".join(
        f'<li class="tl-item"><span class="tl-year">{y}</span><div><h3>{esc(h)}</h3><p>{esc(p)}</p></div></li>'
        for y, h, p in s["story"])
    steps = "\n".join(
        f'<li class="step"><span class="step-n">{i}</span><h3>{esc(h)}</h3><p>{esc(p)}</p></li>'
        for i, (h, p) in enumerate(s["steps"], 1))
    treats = "\n".join(
        f'<div class="treat"><div class="treat-head"><h3>{esc(n)}</h3><span class="price">{esc(pr)}</span></div><p>{esc(d)}</p></div>'
        for n, d, pr in s["treats"])
    sizes = "\n".join(f'<tr><th scope="row">{esc(a)}</th><td>{esc(b)}</td><td class="price">{esc(c)}</td></tr>'
                      for a, b, c in s["sizes"])
    reviews = "\n".join(f'<figure class="review"><blockquote>“{esc(q)}”</blockquote><figcaption>{esc(w)}</figcaption></figure>'
                        for q, w in s["reviews"])
    faq = "\n".join(f'<details><summary>{esc(q)}</summary><p>{esc(a)}</p></details>' for q, a in s["faq"])
    data = json.dumps({"flavors": s["flavors"], "hours": s["hours"]})

    html = TEMPLATE
    for key, val in {
        "NAME": esc(s["name"]), "SHORT": esc(s["short"]), "FOUNDED": str(s["founded"]),
        "YEARS": str(years), "TOWN": esc(s["town"]), "TAGLINE": esc(s["tagline"]),
        "ADDRESS": esc(s["address"]), "PHONE": esc(s["phone"]),
        "PHONE_LINK": "".join(c for c in s["phone"] if c.isdigit()),
        "EMAIL": esc(s["email"]), "MAPS": esc(s["maps_url"]), "INSTAGRAM": esc(s["instagram"]),
        "STORY": story, "STEPS": steps, "TREATS": treats, "SIZES": sizes,
        "REVIEWS": reviews, "FAQ": faq, "DATA": data,
    }.items():
        html = html.replace("{{" + key + "}}", val)
    out = Path(__file__).parent / "index.html"
    out.write_text(html, encoding="utf-8")
    print(f"Built {out} ({len(html):,} characters)")


if __name__ == "__main__":
    build()
